generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public"]
}

model Application {
  id                String   @id @default(cuid())
  code              String   @unique
  name              String
  baseUrl           String   @map("base_url")
  webhookPath       String   @map("webhook_path") @default("/api/internal/payment-completed")
  internalSecretRef String   @map("internal_secret_ref")
  apiKey            String?  @unique @map("api_key")
  isActive          Boolean  @map("is_active") @default(true)
  createdAt         DateTime @map("created_at") @default(now())
  updatedAt         DateTime @map("updated_at") @updatedAt

  tenants               Tenant[]
  paymentTypes          PaymentType[]
  paymentIntents        PaymentIntent[]
  internalNotifications InternalNotification[]
  smsMessages           SmsMessage[]

  @@map("applications")
  @@schema("public")
}

model SmsMessage {
  id                String       @id @default(cuid())
  reference         String       @unique
  recipient         String
  message           String
  // queued | pending | delivered | failed
  status            String       @default("queued")
  attemptCount      Int          @map("attempt_count") @default(0)
  applicationId     String?      @map("application_id")
  application       Application? @relation(fields: [applicationId], references: [id])
  applicationCode   String       @map("application_code")
  providerCode      String       @map("provider_code")
  cost              Int          @default(0)
  senderId          String?      @map("sender_id")
  providerMessageId String?      @map("provider_message_id")
  failureReason     String?      @map("failure_reason")
  nextAttemptAt     DateTime?    @map("next_attempt_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@index([providerMessageId])
  @@index([recipient, createdAt])
  @@index([applicationCode, createdAt])
  @@map("sms_messages")
  @@schema("public")
}

model Provider {
  id                    String                 @id @default(cuid())
  code                  String                 @unique
  name                  String
  credentialsRef        String                 @map("credentials_ref")
  isActive              Boolean                @map("is_active") @default(true)
  createdAt             DateTime               @map("created_at") @default(now())
  updatedAt             DateTime               @map("updated_at") @updatedAt

  tenants               Tenant[]
  paymentIntents        PaymentIntent[]
  webhookLogs           WebhookLog[]
  tenantProviderConfigs TenantProviderConfig[]

  @@map("providers")
  @@schema("public")
}

model Tenant {
  id                    String                 @id @default(cuid())
  applicationId         String                 @map("application_id")
  application           Application            @relation(fields: [applicationId], references: [id])
  code                  String
  name                  String
  defaultProviderId     String?                @map("default_provider_id")
  defaultProvider       Provider?              @relation(fields: [defaultProviderId], references: [id])
  isActive              Boolean                @map("is_active") @default(true)
  createdAt             DateTime               @map("created_at") @default(now())
  updatedAt             DateTime               @map("updated_at") @updatedAt

  paymentIntents        PaymentIntent[]
  tenantProviderConfigs TenantProviderConfig[]
  wallets               WalletAccount[]

  @@unique([applicationId, code])
  @@map("tenants")
  @@schema("public")
}

model PaymentType {
  id            String      @id @default(cuid())
  applicationId String      @map("application_id")
  application   Application @relation(fields: [applicationId], references: [id])
  code          String
  description   String?
  createdAt     DateTime    @map("created_at") @default(now())

  paymentIntents PaymentIntent[]

  @@unique([applicationId, code])
  @@map("payment_types")
  @@schema("public")
}

model PaymentIntent {
  id            String       @id @default(cuid())
  applicationId String       @map("application_id")
  application   Application  @relation(fields: [applicationId], references: [id])
  tenantId      String?      @map("tenant_id")
  tenant        Tenant?      @relation(fields: [tenantId], references: [id])
  paymentTypeId String?      @map("payment_type_id")
  paymentType   PaymentType? @relation(fields: [paymentTypeId], references: [id])

  externalEntityId String? @map("external_entity_id")
  reference        String  @unique
  // Idempotency is scoped per application. A globally unique key meant partner
  // app B could never reuse a key already used by app A — the request silently
  // returned app A's payment instead of creating B's.
  idempotencyKey   String  @map("idempotency_key")

  amount      Decimal @db.Decimal(14, 2)
  currency    String  @default("UGX")
  phoneNumber String? @map("phone_number")

  providerId        String   @map("provider_id")
  provider          Provider @relation(fields: [providerId], references: [id])
  providerPaymentId String?  @map("provider_payment_id")

  status        String  @default("pending")
  metadata      String  @default("{}")
  failureReason String? @map("failure_reason")

  createdAt   DateTime  @map("created_at") @default(now())
  updatedAt   DateTime  @map("updated_at") @updatedAt
  completedAt DateTime? @map("completed_at")
  lastPolledAt DateTime? @map("last_polled_at")

  transactions          PaymentTransaction[]
  webhookLogs           WebhookLog[]
  internalNotifications InternalNotification[]
  ledgerEntries         LedgerEntry[]

  @@unique([applicationId, idempotencyKey])
  @@index([status, lastPolledAt])
  @@index([applicationId])
  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@index([providerPaymentId])
  // FIX: composite index speeds up dashboard per-app, per-status queries 
  @@index([applicationId, status, createdAt])
  @@map("payment_intents")
  @@schema("public")
}

model PaymentTransaction {
  id                  String        @id @default(cuid())
  paymentIntentId     String        @map("payment_intent_id")
  paymentIntent       PaymentIntent @relation(fields: [paymentIntentId], references: [id])
  status              String
  rawProviderResponse String?       @map("raw_provider_response")
  note                String?
  createdAt           DateTime      @map("created_at") @default(now())    

  @@index([paymentIntentId])
  @@index([createdAt])
  @@map("payment_transactions")
  @@schema("public")
}

model WebhookLog {
  id              String         @id @default(cuid())
  providerId      String         @map("provider_id")
  provider        Provider       @relation(fields: [providerId], references: [id])
  paymentIntentId String?        @map("payment_intent_id")
  paymentIntent   PaymentIntent? @relation(fields: [paymentIntentId], references: [id])

  payload       String
  headers       String?
  // FIX: SHA-256(provider+signature+body) — unique key for idempotency dedup
  // Prevents duplicate processing when LivePay retries a webhook
  signatureHash   String?  @unique @map("signature_hash")
  signatureValid  Boolean  @map("signature_valid")
  processed       Boolean  @default(false)
  processingError String?  @map("processing_error")
  createdAt       DateTime @map("created_at") @default(now())

  @@index([providerId])
  @@index([paymentIntentId])
  @@index([createdAt])
  @@map("webhook_logs")
  @@schema("public")
}

model InternalNotification {
  id               String   @id @default(cuid())
  paymentIntentId  String   @map("payment_intent_id")
  paymentIntent    PaymentIntent @relation(fields: [paymentIntentId], references: [id])
  applicationId    String   @map("application_id")
  application      Application @relation(fields: [applicationId], references: [id])

  url              String
  payload          String

  status           String   @default("pending")
  attemptCount     Int      @map("attempt_count") @default(0)
  maxAttempts      Int      @map("max_attempts") @default(5)

  lastAttemptAt    DateTime? @map("last_attempt_at")
  nextRetryAt      DateTime? @map("next_retry_at")
  lastResponseStatus Int?  @map("last_response_status")
  lastResponseBody  String?  @map("last_response_body")

  createdAt        DateTime @map("created_at") @default(now())
  updatedAt        DateTime @map("updated_at") @updatedAt

  @@index([paymentIntentId])
  @@index([status, nextRetryAt])
  @@map("internal_notifications")
  @@schema("public")
}

enum AdminRoleEnum {
  doctor
  nurse
  pharmacist
  admin
  member
  pastor
  sacco_admin
  super_admin
  school_admin

  @@map("admin_role_enum")
  @@schema("public")
}

model AdminProfile {
  id               String         @id
  // SECURITY: this defaulted to `super_admin`, so any row inserted without an
  // explicit role silently became a full platform administrator.
  // Default to the least-privileged role; elevate deliberately.
  role             AdminRoleEnum  @default(member)
  createdAt        DateTime       @map("created_at") @default(now())
  updatedAt        DateTime       @map("updated_at") @updatedAt

  @@map("admin_profiles")
  @@schema("public")
}

model TenantProviderConfig {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  providerId     String    @map("provider_id")
  provider       Provider  @relation(fields: [providerId], references: [id])
  credentialsRef String?   @map("credentials_ref")
  configJson     Json      @default("{}") @map("config_json")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, providerId])
  @@index([tenantId, isActive])
  @@index([tenantId, providerId])
  @@map("tenant_provider_configs")
  @@schema("public")
}

model WalletAccount {
  id           String        @id @default(cuid())
  tenantId     String        @map("tenant_id")
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  appCode      String        @map("app_code")
  currency     String        @default("UGX")
  balanceMinor BigInt        @default(0) @map("balance_minor")
  version      Int           @default(0)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  ledgerEntries LedgerEntry[]

  @@unique([tenantId, appCode, currency])
  @@index([tenantId])
  @@map("wallet_accounts")
  @@schema("public")
}

model LedgerEntry {
  id                String         @id @default(cuid())
  walletId          String         @map("wallet_id")
  wallet            WalletAccount  @relation(fields: [walletId], references: [id])
  paymentIntentId   String?        @map("payment_intent_id")
  paymentIntent     PaymentIntent? @relation(fields: [paymentIntentId], references: [id])
  direction         String         // 'credit' | 'debit'
  amountMinor       BigInt         @map("amount_minor")
  currency          String         @default("UGX")
  entryType         String         @map("entry_type") // payment_in | payout | fee | reversal | adjustment
  idempotencyKey    String         @unique @map("idempotency_key")
  balanceAfterMinor BigInt         @map("balance_after_minor")
  createdAt         DateTime       @default(now()) @map("created_at")

  @@index([walletId, createdAt])
  @@map("ledger_entries")
  @@schema("public")
}


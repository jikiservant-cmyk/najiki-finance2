# ============================================================================
# Na'jiki Tech — Payment & Messaging Gateway
# Environment template. Copy to `.env` (or `.env.local`) and fill in real values.
#
#   cp .env.example .env
#
# Variables marked [REQUIRED IN PRODUCTION] are validated at boot by
# src/lib/env.ts (invoked from src/instrumentation.ts). The app refuses to
# start in production if any of them are missing or malformed — so you find
# out at deploy time, not when a payment fails.
# ============================================================================

# ----------------------------------------------------------------------------
# Database — Supabase PostgreSQL
# Supabase Dashboard > Project Settings > Database > Connection String > Pooler
# ----------------------------------------------------------------------------
# [REQUIRED IN PRODUCTION] Runtime connection (PgBouncer, port 6543, transaction mode)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"
# Migrations only — direct connection (port 5432, bypasses the pooler)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ----------------------------------------------------------------------------
# Encryption — multi-tenant provider credentials at rest (AES-256-GCM)
# [REQUIRED IN PRODUCTION] Must be exactly 64 hex characters (32 bytes).
# Generate with:  openssl rand -hex 32
# WARNING: rotating this value makes all previously stored tenant credentials
# undecryptable. Re-enter them in the setup screen after changing it.
# ----------------------------------------------------------------------------
APP_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
# DEVELOPMENT ONLY. Not read by any auth library (next-auth is not a dependency).
# src/lib/encryption.ts uses it to derive the local AES key when
# APP_ENCRYPTION_KEY is unset — so a deployment with no APP_ENCRYPTION_KEY
# encrypts with a key derived from whatever this is, or from a hard-coded
# default. Production refuses to run without a valid APP_ENCRYPTION_KEY, but
# staging does not: give staging an APP_ENCRYPTION_KEY too, or a database copied
# between staging machines will throw "Decryption failed" on every read.
NEXTAUTH_SECRET=""

# ----------------------------------------------------------------------------
# Supabase Auth — dashboard login (email + password)
# ----------------------------------------------------------------------------
# [REQUIRED IN PRODUCTION] These are public values (shipped to the browser).
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-side only. Used by src/lib/supabase.ts — never expose this to a client.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ----------------------------------------------------------------------------
# Dashboard access control
# [REQUIRED IN PRODUCTION] Comma-separated allowlist of emails that are
# auto-provisioned as super_admin on first login.
# There is NO default — if this is empty, nobody can reach the dashboard.
# ----------------------------------------------------------------------------
SUPER_ADMIN_EMAILS="you@yourcompany.com"

# ----------------------------------------------------------------------------
# Application public URL
# [REQUIRED IN PRODUCTION] The externally reachable HTTPS origin of this app.
# Used to build the webhook URL sent to LivePay AND as part of the webhook
# signature string, so it must match what the provider calls.
# (Name kept as NEXTAUTH_URL for backwards compatibility — this app does not
# use NextAuth.)
# ----------------------------------------------------------------------------
NEXTAUTH_URL="https://payments.yourdomain.com"

# ----------------------------------------------------------------------------
# LivePay (payment provider)
# ----------------------------------------------------------------------------
# [REQUIRED IN PRODUCTION] All three of the following.
LIVEPAY_API_KEY="your-livepay-api-key"
LIVEPAY_ACCOUNT_NO="your-livepay-account-number"
# Must be at least 16 characters. Webhook signature verification fails closed
# (rejects everything) if this is missing or shorter than 16 chars.
LIVEPAY_WEBHOOK_SECRET="your-livepay-webhook-secret"
LIVEPAY_BASE_URL="https://livepay.me"

# ----------------------------------------------------------------------------
# Africa's Talking (SMS)
# Required for SMS to actually send. With no API key the app simulates
# "successful" delivery in development and REFUSES to run in production.
# ----------------------------------------------------------------------------
AFRICASTALKING_API_KEY="your-africastalking-api-key"
AFRICASTALKING_USERNAME="your-africastalking-username"
AFRICASTALKING_SENDER_ID="your-registered-sender-id"
# Shared secret required on delivery-report callbacks (X-Callback-Secret).
# [REQUIRED IN PRODUCTION] The callback endpoint fails closed without it, so a
# deployment that omits it silently stops receiving delivery reports.
#
# Register THIS exact URL as the Africa's Talking delivery-report callback
# (the /api/messaging/callback alias also works and is exempt from the session
# gate).
#
# THE SECRET MUST BE IN THE URL. Africa's Talking does not sign its callbacks and
# does not send custom headers, so a header-only check rejected every delivery
# report with 401 — messages stayed "delivered" forever even when the carrier
# rejected them, because the DLR is the only thing that can correct that status.
# Paste the secret in as the `key` query parameter:
#
#     https://<your-domain>/api/webhooks/africastalking?key=your-secret-here
#
# A query-string secret lands in access logs, so treat the full callback URL as a
# credential — and set AFRICASTALKING_ALLOWED_IPS below so a leaked URL alone is
# not enough. The x-callback-secret header is still accepted if you ever proxy
# the callback through something that can add one.
AFRICASTALKING_CALLBACK_SECRET="your-africastalking-dlr-callback-secret"

# Africa's Talking callback source IPs, comma separated.
#
# READ THIS BEFORE RELYING ON IT. The client IP is read from the
# `x-forwarded-for` header, which the caller can populate. A request that fails
# the secret check is therefore NOT authorised by a matching IP, because an
# attacker who knows these (public) addresses could simply claim one:
#
#   AFRICASTALKING_REQUIRE_ALLOWED_IP="true"   # make the IP an ADDITIONAL requirement
#
# Set that only if this app sits behind a proxy you control that overwrites
# `x-forwarded-for`. On its own — with no secret configured — the list is still
# accepted as the sole method, which is not reachable in production because
# AFRICASTALKING_CALLBACK_SECRET is required there.
#   AFRICASTALKING_ALLOWED_IPS="18.133.205.228,35.177.236.113"
AFRICASTALKING_ALLOWED_IPS=""
AFRICASTALKING_REQUIRE_ALLOWED_IP=""

# ----------------------------------------------------------------------------
# Proxy topology — how the client IP is derived
# ----------------------------------------------------------------------------
# `x-forwarded-for` is a list our proxies append to, so the trustworthy entries
# are at the RIGHT. Reading the leftmost entry reads a value the caller chose,
# which defeats per-IP rate limiting entirely. TRUSTED_PROXY_HOPS is how many
# proxies of your own sit in front of the app (default 1 — one edge or load
# balancer). Raising it beyond the number you actually run reads a spoofable
# entry, so do not guess.
#   TRUSTED_PROXY_HOPS="1"
TRUSTED_PROXY_HOPS=""

# `x-real-ip` has no defined provenance — anything that can set a header can set
# it — so it is ignored unless you explicitly enable it, and even then only when
# `x-forwarded-for` is absent.
#   TRUST_X_REAL_IP="true"
TRUST_X_REAL_IP=""

# ----------------------------------------------------------------------------
# Webhook simulation (OFF unless explicitly enabled)
# ----------------------------------------------------------------------------
# Enables POST /api/webhooks/simulate, which marks a pending payment successful
# from the dashboard so the Webhooks page can be exercised without a provider.
# It moves no money, refuses to touch an already-settled payment, requires a
# super-admin session, and writes an audit row — but it is still a way to
# manufacture a "success" payment, so it is disabled by default and answers 404
# (not 403) when off, so an unconfigured deployment does not advertise it.
#   ALLOW_WEBHOOK_SIMULATION="true"        # staging/development only
ALLOW_WEBHOOK_SIMULATION=""

# ----------------------------------------------------------------------------
# Payment provider selection
# ----------------------------------------------------------------------------
# Which implemented provider new payments use when the tenant has no default.
# Optional: the fallback is the oldest active provider that has a working
# adapter. Set it to be explicit rather than implicitly ordered.
#   DEFAULT_PROVIDER_CODE="livepay"
DEFAULT_PROVIDER_CODE=""

# ----------------------------------------------------------------------------
# Phone-number retention
# ----------------------------------------------------------------------------
# Days a customer phone number is kept before it is masked (or purged). 0 is the
# ONLY value that disables retention — a typo falls back to the default of 90
# rather than silently keeping everything.
#   PHONE_RETENTION_DAYS="90"
#   PHONE_RETENTION_MODE="mask"    # or "purge" to delete the number outright
PHONE_RETENTION_DAYS=""
PHONE_RETENTION_MODE=""

# ----------------------------------------------------------------------------
# Public URL + background worker tuning
# ----------------------------------------------------------------------------
# Absolute public origin, no trailing slash. Used by scripts/setup-cron-schedules
# to register QStash schedules; falls back to NEXTAUTH_URL.
PUBLIC_BASE_URL=""

# Alert thresholds for /api/cron/alerts (wallet reconciliation drift).
#   ALERT_WALLET_SCAN_LIMIT: how many wallets to scan per run (default 1000).
#   ALERT_WALLET_DRIFT_WALLETS: alert once this many wallets have drifted (default 1).
# A single drifted wallet is a real accounting discrepancy, hence the default of 1.
ALERT_WALLET_SCAN_LIMIT=""
ALERT_WALLET_DRIFT_WALLETS=""

# Wall-clock budget for one /api/cron/notifications run, in milliseconds
# (default 40000). Keeps the worker under the platform request timeout and
# stops a large backlog from being killed mid-batch.
NOTIFICATION_WORKER_BUDGET_MS=""

# ----------------------------------------------------------------------------
# Upstash Redis — SMS queue + distributed rate limiting
# [REQUIRED IN PRODUCTION] The in-memory fallback is refused in production
# because queued messages are lost on every cold start.
# ----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token"

# ----------------------------------------------------------------------------
# Upstash QStash — background webhook delivery with retries
# Optional: if QSTASH_TOKEN is unset, webhooks are delivered directly and
# retried by the /api/cron/notifications worker instead.
#
# Strongly recommended in production: QStash Schedules are how the workers run
# at minute granularity. Vercel's Hobby plan only allows two *daily* crons (a
# sub-daily expression fails the deployment), so registering them here is the
# portable option:  npm run cron:setup
# ----------------------------------------------------------------------------
QSTASH_TOKEN="your-qstash-token"
QSTASH_CURRENT_SIGNING_KEY="your-qstash-current-signing-key"
QSTASH_NEXT_SIGNING_KEY="your-qstash-next-signing-key"

# ----------------------------------------------------------------------------
# Cron authentication
# [REQUIRED IN PRODUCTION] At least 16 characters. Bearer secret for the
# /api/cron/* and /api/qstash/* worker endpoints. Vercel Cron sends this
# automatically when configured (see vercel.json).
# Generate with:  openssl rand -hex 32
# ----------------------------------------------------------------------------
CRON_SECRET="your-cron-secret-here"

# ----------------------------------------------------------------------------
# Operational alerting — used by /api/cron/alerts
# Optional. Without a webhook URL, findings are only returned in the endpoint
# response (and therefore only visible to whatever polls it).
# Works with Slack, Discord or any endpoint accepting a JSON POST.
# ----------------------------------------------------------------------------
ALERT_WEBHOOK_URL=""
# Thresholds (defaults shown). Tune per environment.
ALERT_STUCK_PAYMENT_MINUTES="60"
ALERT_STUCK_PAYMENT_COUNT="5"
ALERT_EXHAUSTED_NOTIFICATIONS="1"
ALERT_SMS_QUEUE_BACKLOG="100"
ALERT_FAILED_SMS="20"

# ----------------------------------------------------------------------------
# CORS — origins allowed to call the public payment/messaging APIs
# Comma-separated. Required in production: without it, cross-origin browser
# requests are rejected.
# ----------------------------------------------------------------------------
ALLOWED_ORIGINS="https://app.example.com,https://church.example.com"

# ----------------------------------------------------------------------------
# Optional — Inngest (not wired up; reserved for future background jobs)
# ----------------------------------------------------------------------------
# INNGEST_EVENT_KEY="your-inngest-event-key"
# INNGEST_SIGNING_KEY="your-inngest-signing-key"

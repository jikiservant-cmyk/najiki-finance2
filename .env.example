# ============================================================================
# Na'jiki Tech — Payment & Messaging Gateway
# Environment template. Copy to `.env` (or `.env.local`) and fill in real values.
#
#   cp .env.example .env
#
# Variables marked [REQUIRED IN PRODUCTION] are validated at boot by
# src/lib/env.ts (invoked from src/instrumentation.ts). The app refuses to
# start in production if any of them are missing or malformed — so you find
# out at deploy time, not when a payment fails.
# ============================================================================

# ----------------------------------------------------------------------------
# Database — Supabase PostgreSQL
# Supabase Dashboard > Project Settings > Database > Connection String > Pooler
# ----------------------------------------------------------------------------
# [REQUIRED IN PRODUCTION] Runtime connection (PgBouncer, port 6543, transaction mode)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"
# Migrations only — direct connection (port 5432, bypasses the pooler)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ----------------------------------------------------------------------------
# Encryption — multi-tenant provider credentials at rest (AES-256-GCM)
# [REQUIRED IN PRODUCTION] Must be exactly 64 hex characters (32 bytes).
# Generate with:  openssl rand -hex 32
# WARNING: rotating this value makes all previously stored tenant credentials
# undecryptable. Re-enter them in the setup screen after changing it.
# ----------------------------------------------------------------------------
APP_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ----------------------------------------------------------------------------
# Supabase Auth — dashboard login (email + password)
# ----------------------------------------------------------------------------
# [REQUIRED IN PRODUCTION] These are public values (shipped to the browser).
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-side only. Used by src/lib/supabase.ts — never expose this to a client.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ----------------------------------------------------------------------------
# Dashboard access control
# [REQUIRED IN PRODUCTION] Comma-separated allowlist of emails that are
# auto-provisioned as super_admin on first login.
# There is NO default — if this is empty, nobody can reach the dashboard.
# ----------------------------------------------------------------------------
SUPER_ADMIN_EMAILS="you@yourcompany.com"

# ----------------------------------------------------------------------------
# Application public URL
# [REQUIRED IN PRODUCTION] The externally reachable HTTPS origin of this app.
# Used to build the webhook URL sent to LivePay AND as part of the webhook
# signature string, so it must match what the provider calls.
# (Name kept as NEXTAUTH_URL for backwards compatibility — this app does not
# use NextAuth.)
# ----------------------------------------------------------------------------
NEXTAUTH_URL="https://payments.yourdomain.com"

# ----------------------------------------------------------------------------
# LivePay (payment provider)
# ----------------------------------------------------------------------------
# [REQUIRED IN PRODUCTION] All three of the following.
LIVEPAY_API_KEY="your-livepay-api-key"
LIVEPAY_ACCOUNT_NO="your-livepay-account-number"
# Must be at least 16 characters. Webhook signature verification fails closed
# (rejects everything) if this is missing or shorter than 16 chars.
LIVEPAY_WEBHOOK_SECRET="your-livepay-webhook-secret"
LIVEPAY_BASE_URL="https://livepay.me"

# ----------------------------------------------------------------------------
# Africa's Talking (SMS)
# Required for SMS to actually send. With no API key the app simulates
# "successful" delivery in development and REFUSES to run in production.
# ----------------------------------------------------------------------------
AFRICASTALKING_API_KEY="your-africastalking-api-key"
AFRICASTALKING_USERNAME="your-africastalking-username"
AFRICASTALKING_SENDER_ID="your-registered-sender-id"
# Shared secret required on delivery-report callbacks (X-Callback-Secret).
# [REQUIRED IN PRODUCTION] The callback endpoint fails closed without it.
AFRICASTALKING_CALLBACK_SECRET="your-africastalking-dlr-callback-secret"

# ----------------------------------------------------------------------------
# Upstash Redis — SMS queue + distributed rate limiting
# [REQUIRED IN PRODUCTION] The in-memory fallback is refused in production
# because queued messages are lost on every cold start.
# ----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token"

# ----------------------------------------------------------------------------
# Upstash QStash — background webhook delivery with retries
# Optional: if QSTASH_TOKEN is unset, webhooks are delivered directly and
# retried by the /api/cron/notifications worker instead.
# ----------------------------------------------------------------------------
QSTASH_TOKEN="your-qstash-token"
QSTASH_CURRENT_SIGNING_KEY="your-qstash-current-signing-key"
QSTASH_NEXT_SIGNING_KEY="your-qstash-next-signing-key"

# ----------------------------------------------------------------------------
# Cron authentication
# [REQUIRED IN PRODUCTION] At least 16 characters. Bearer secret for the
# /api/cron/* and /api/qstash/* worker endpoints. Vercel Cron sends this
# automatically when configured (see vercel.json).
# Generate with:  openssl rand -hex 32
# ----------------------------------------------------------------------------
CRON_SECRET="your-cron-secret-here"

# ----------------------------------------------------------------------------
# CORS — origins allowed to call the public payment/messaging APIs
# Comma-separated. Required in production: without it, cross-origin browser
# requests are rejected.
# ----------------------------------------------------------------------------
ALLOWED_ORIGINS="https://app.example.com,https://church.example.com"

# ----------------------------------------------------------------------------
# Optional — Inngest (not wired up; reserved for future background jobs)
# ----------------------------------------------------------------------------
# INNGEST_EVENT_KEY="your-inngest-event-key"
# INNGEST_SIGNING_KEY="your-inngest-signing-key"

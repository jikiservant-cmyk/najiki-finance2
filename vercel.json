{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/notifications",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/sync-payments",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/qstash/sms-cron",
      "schedule": "* * * * *"
    }
  ]
}
